{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio-exchange.invalid/schemas/feed.schema.json",
  "title": "FOLIO-Exchange feed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "uses": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*@\\S+$",
      "description": "recipe@range, e.g. chq-academic@^1.0"
    },
    "title": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "file_prefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_suppressed_instances": {
          "type": "boolean"
        },
        "include_suppressed_items": {
          "type": "boolean"
        },
        "include_suppressed_holdings": {
          "type": "boolean"
        },
        "include_items_without_barcode": {
          "type": "boolean"
        },
        "bibs_without_items": {
          "type": "boolean"
        },
        "exclude_item_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_location_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_location_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_circ_date_from": {
          "enum": [
            "checkout",
            "any"
          ]
        },
        "loan_window_months": {
          "type": "integer",
          "minimum": 1
        },
        "timezone": {
          "type": "string",
          "description": "An IANA zone such as America/New_York"
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_date_note_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "circ_count_note_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_circ_date_note_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_format": {
          "type": [
            "string",
            "null"
          ],
          "description": "How legacy date notes are written when not ISO 8601, as a strftime pattern with a day, month and year, e.g. %d/%m/%Y"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file_name": {
            "type": "string",
            "pattern": "^([A-Za-z0-9._-]|\\{prefix\\}|\\{date\\})+$"
          },
          "split_every": {
            "type": "integer",
            "minimum": 0
          },
          "embed_items": {
            "type": "boolean"
          },
          "item_field": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tag": {
                "type": "string",
                "pattern": "^(0[1-9][0-9]|[1-9][0-9]{2})$"
              },
              "strip_existing": {
                "type": "boolean"
              },
              "max_per_record": {
                "type": "integer",
                "minimum": 1
              },
              "subfields": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z0-9]$"
                },
                "additionalProperties": {
                  "enum": [
                    "barcode",
                    "call_number",
                    "call_number_bare",
                    "call_number_full",
                    "call_number_prefix",
                    "call_number_suffix",
                    "call_number_type",
                    "campus_code",
                    "campus_name",
                    "chronology",
                    "copy_number",
                    "created_date",
                    "due_date",
                    "enumeration",
                    "holdings_hrid",
                    "instance_hrid",
                    "instance_id",
                    "instance_suppressed",
                    "institution_code",
                    "institution_name",
                    "item_hrid",
                    "item_id",
                    "item_identifier",
                    "item_level_call_number",
                    "item_suppressed",
                    "last_checkin_date",
                    "last_checkout_date",
                    "last_circ_date",
                    "last_return_date",
                    "legacy_circ_count",
                    "library_code",
                    "library_name",
                    "loan_type",
                    "loans_folio",
                    "loans_total",
                    "loans_window",
                    "location_code",
                    "location_name",
                    "location_name_code",
                    "material_type",
                    "number_of_pieces",
                    "permanent_location_code",
                    "renewals_total",
                    "status",
                    "status_date",
                    "title",
                    "volume"
                  ],
                  "description": "A field from `folio-exchange fields`."
                }
              }
            }
          },
          "date_format": {
            "type": "string",
            "pattern": "%",
            "description": "A strftime pattern, e.g. %Y-%m-%d"
          },
          "extension": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$",
            "not": {
              "pattern": "^[Mm][Rr][Cc]$"
            }
          },
          "delimiter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "header": {
            "type": "boolean"
          },
          "empty_value": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "header": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "enum": [
                    "barcode",
                    "call_number",
                    "call_number_bare",
                    "call_number_full",
                    "call_number_prefix",
                    "call_number_suffix",
                    "call_number_type",
                    "campus_code",
                    "campus_name",
                    "chronology",
                    "copy_number",
                    "created_date",
                    "due_date",
                    "enumeration",
                    "holdings_hrid",
                    "instance_hrid",
                    "instance_id",
                    "instance_suppressed",
                    "institution_code",
                    "institution_name",
                    "item_hrid",
                    "item_id",
                    "item_identifier",
                    "item_level_call_number",
                    "item_suppressed",
                    "last_checkin_date",
                    "last_checkout_date",
                    "last_circ_date",
                    "last_return_date",
                    "legacy_circ_count",
                    "library_code",
                    "library_name",
                    "loan_type",
                    "loans_folio",
                    "loans_total",
                    "loans_window",
                    "location_code",
                    "location_name",
                    "location_name_code",
                    "material_type",
                    "number_of_pieces",
                    "permanent_location_code",
                    "renewals_total",
                    "status",
                    "status_date",
                    "title",
                    "volume"
                  ],
                  "description": "A field from `folio-exchange fields`."
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "header",
                "field"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_item_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "must_be_filled": {
          "type": "array",
          "items": {
            "enum": [
              "barcode",
              "call_number",
              "call_number_bare",
              "call_number_full",
              "call_number_prefix",
              "call_number_suffix",
              "call_number_type",
              "campus_code",
              "campus_name",
              "chronology",
              "copy_number",
              "created_date",
              "due_date",
              "enumeration",
              "holdings_hrid",
              "instance_hrid",
              "instance_id",
              "instance_suppressed",
              "institution_code",
              "institution_name",
              "item_hrid",
              "item_id",
              "item_identifier",
              "item_level_call_number",
              "item_suppressed",
              "last_checkin_date",
              "last_checkout_date",
              "last_circ_date",
              "last_return_date",
              "legacy_circ_count",
              "library_code",
              "library_name",
              "loan_type",
              "loans_folio",
              "loans_total",
              "loans_window",
              "location_code",
              "location_name",
              "location_name_code",
              "material_type",
              "number_of_pieces",
              "permanent_location_code",
              "renewals_total",
              "status",
              "status_date",
              "title",
              "volume"
            ],
            "description": "A field from `folio-exchange fields`."
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": [
            "sftp",
            "local",
            "none"
          ]
        },
        "upload_mode": {
          "enum": [
            "staged",
            "direct"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_dir": {
          "type": "string"
        },
        "host_key_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^SHA256:"
        },
        "host_key_confirmed": {
          "type": "boolean",
          "description": "false until the fingerprint is confirmed with the vendor; nothing logs in while it is false"
        },
        "known_hosts": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret": {
          "type": "string",
          "pattern": "^(keyring|env:[A-Za-z_][A-Za-z0-9_]*)$",
          "description": "Where the secret lives: keyring, or env:NAME. Never the secret itself."
        },
        "private_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "schedule": {
      "type": "string"
    }
  },
  "required": [
    "uses"
  ],
  "description": "A FOLIO-Exchange feed: feeds/<name>.yaml, local settings over a shared recipe"
}
