{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio-exchange.invalid/schemas/site.schema.json",
  "title": "FOLIO-Exchange site",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "folio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "tenant": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "secret": {
          "type": "string",
          "pattern": "^(keyring|env:[A-Za-z_][A-Za-z0-9_]*)$",
          "description": "Where the secret lives: keyring, or env:NAME. Never the secret itself."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1
        },
        "srs_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "number"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "verify_tls": {
          "type": "boolean"
        },
        "srs_include_shared": {
          "type": "boolean"
        },
        "ca_bundle": {
          "type": [
            "string",
            "null"
          ],
          "description": "Check FOLIO's certificate against these instead of the usual public ones: the path of a PEM file (relative to the site folder), or windows for the Windows certificate store, which also trusts what the library's IT has added. For campus networks that inspect TLS; better than verify_tls: false."
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "full",
            "delta"
          ]
        },
        "full_refresh_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "string"
        },
        "out": {
          "type": "string"
        },
        "logs": {
          "type": "string"
        },
        "feeds": {
          "type": "string"
        },
        "recipes": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_local_runs": {
          "type": "integer",
          "minimum": 0
        },
        "history_months": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts_per_slot": {
          "type": "integer",
          "minimum": 1
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "enum": [
            "failure",
            "always",
            "never"
          ]
        },
        "webhook": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(keyring|env:[A-Za-z_][A-Za-z0-9_]*)$",
              "description": "Where the secret lives: keyring, or env:NAME. Never the secret itself."
            },
            {
              "type": "null"
            }
          ]
        },
        "webhook_format": {
          "enum": [
            "slack",
            "teams"
          ]
        },
        "email": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "from": {
                  "type": "string"
                },
                "smtp_host": {
                  "type": "string"
                },
                "smtp_port": {
                  "type": "integer"
                },
                "starttls": {
                  "type": "boolean"
                },
                "username": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "secret": {
                  "type": "string",
                  "pattern": "^(keyring|env:[A-Za-z_][A-Za-z0-9_]*)$",
                  "description": "Where the secret lives: keyring, or env:NAME. Never the secret itself."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "heartbeat": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(keyring|env:[A-Za-z_][A-Za-z0-9_]*)$",
              "description": "Where the secret lives: keyring, or env:NAME. Never the secret itself."
            },
            {
              "type": "null"
            }
          ],
          "description": "A dead-man's-switch monitor's ping URL (keyring or env:NAME), requested after every hourly run --due, so a monitor notices when the scheduled task stops running."
        }
      }
    },
    "recipe_sources": {
      "type": "array",
      "description": "This site's own vendor recipe sources, added to the curated list that ships with FOLIO-Exchange.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vendor",
          "title",
          "repo",
          "recipes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "vendor": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9._-]+$",
            "description": "A GitHub repository, owner/name."
          },
          "branch": {
            "type": "string",
            "description": "Default main."
          },
          "path": {
            "type": "string",
            "description": "The folder holding <recipe-id>/<version>.yaml; default recipes."
          },
          "recipes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "description": "The recipe ids this source may provide."
          },
          "homepage": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  },
  "description": "FOLIO-Exchange site settings: site.yaml"
}
